  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RunGun.Levels.TutorialDialogueController
  lines:
  - speakerName: Blue Guy
    text: This trial adds the rifle. It fires quickly, so keep moving while you clear
      groups of targets.
    speakerPosePrefab: {fileID: 2736272047063480907, guid: ca5a1075237da5545b10438e8106affd, type: 3}
  - speakerName: Blue Guy
    text: The rifle gives only a small movement push. Its real strength is hitting
      several things without breaking your flow.
    speakerPosePrefab: {fileID: 2736272047063480907, guid: 9804a0ccb68c4404f9d2f5dce9c70874, type: 3}
  - speakerName: Blue Guy
    text: Clear the sseven targets ahead to open the first gate.
    speakerPosePrefab: {fileID: 2736272047063480907, guid: a6dce48185b1cf24fb9f542767adc9c2, type: 3}
  playOnStart: 1
  hidePoseOnEnd: 1
