  language: 1
  entries:
  - key: SETTINGS
    text: "\u041D\u0410\u0421\u0422\u0420\u041E\u0419\u041A\u0418"
  - key: DISPLAY
    text: "\u042D\u041A\u0420\u0410\u041D"
  - key: Display
    text: "\u042D\u041A\u0420\u0410\u041D"
  - key: AUDIO
    text: "\u0410\u0423\u0414\u0418\u041E"
  - key: CONTROLS
    text: "\u0423\u041F\u0420\u0410\u0412\u041B\u0415\u041D\u0418\u0415"
  - key: CROSSHAIR
    text: "\u041F\u0420\u0418\u0426\u0415\u041B"
  - key: LANGUAGE
    text: "\u042F\u0417\u042B\u041A"
  - key: RESOLUTION
    text: "\u0420\u0410\u0417\u0420\u0415\u0428\u0415\u041D\u0418\u0415"
  - key: WINDOW MODE
    text: "\u0420\u0415\u0416\u0418\u041C \u042D\u041A\u0420\u0410\u041D\u0410"
  - key: Borderless
    text: "\u0411\u0435\u0437 \u0440\u0430\u043C\u043A\u0438"
  - key: Exclusive Fullscreen
    text: "\u041F\u043E\u043B\u043D\u044B\u0439 \u044D\u043A\u0440\u0430\u043D"
  - key: Windowed
    text: "\u0412 \u043E\u043A\u043D\u0435"
  - key: MUSIC VOLUME
    text: "\u0413\u0420\u041E\u041C\u041A\u041E\u0421\u0422\u042C \u041C\u0423\u0417\u042B\u041A\u0418"
  - key: SFX VOLUME
    text: "\u0413\u0420\u041E\u041C\u041A\u041E\u0421\u0422\u042C \u042D\u0424\u0424\u0415\u041A\u0422\u041E\u0412"
  - key: MOUSE SENSITIVITY
    text: "\u0427\u0423\u0412\u0421\u0422. \u041C\u042B\u0428\u0418"
  - key: KEY BINDINGS
    text: "\u041A\u041B\u0410\u0412\u0418\u0428\u0418"
  - key: MOVE FORWARD
    text: "\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415 \u0412\u041F\u0415\u0420\u0401\u0414"
  - key: MOVE BACKWARD
    text: "\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415 \u041D\u0410\u0417\u0410\u0414"
  - key: MOVE LEFT
    text: "\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415 \u0412\u041B\u0415\u0412\u041E"
  - key: MOVE RIGHT
    text: "\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415 \u0412\u041F\u0420\u0410\u0412\u041E"
  - key: JUMP
    text: "\u041F\u0420\u042B\u0416\u041E\u041A"
  - key: SPRINT
    text: "\u0411\u0415\u0413"
  - key: CROUCH/SLIDE
    text: "\u041F\u0420\u0418\u0421\u0415\u0421\u0422\u042C / \u0421\u041A\u041E\u041B\u042C\u0416\u0415\u041D\u0418\u0415"
  - key: RELOAD
    text: "\u041F\u0415\u0420\u0415\u0417\u0410\u0420\u042F\u0414\u041A\u0410"
  - key: RESET TO DEFAULT
    text: "\u0421\u0411\u0420\u041E\u0421\u0418\u0422\u042C"
  - key: APPEARANCE
    text: "\u0412\u041D\u0415\u0428\u041D\u0418\u0419 \u0412\u0418\u0414"
  - key: STYLE
    text: "\u0422\u0418\u041F"
  - key: COLOR
    text: "\u0426\u0412\u0415\u0422"
  - key: SIZE
    text: "\u0420\u0410\u0417\u041C\u0415\u0420"
  - key: OPACITY
    text: "\u041F\u0420\u041E\u0417\u0420\u0410\u0427\u041D\u041E\u0421\u0422\u042C"
  - key: LIVE PREVIEW
    text: "\u041F\u0420\u0415\u0414\u041F\u0420\u041E\u0421\u041C\u041E\u0422\u0420"
  - key: DOT
    text: "\u0422\u041E\u0427\u041A\u0410"
  - key: CLASSIC
    text: "\u0421\u0422\u0410\u041D\u0414\u0410\u0420\u0422\u041D\u042B\u0419"
  - key: CIRCLE
    text: "\u041A\u0420\u0423\u0413"
  - key: CROSS
    text: "\u041A\u0420\u0415\u0421\u0422"
  - key: WHITE
    text: "\u0411\u0415\u041B\u042B\u0419"
  - key: RED
    text: "\u041A\u0420\u0410\u0421\u041D\u042B\u0419"
  - key: CYAN
    text: "\u0413\u041E\u041B\u0423\u0411\u041E\u0419"
  - key: GREEN
    text: "\u0417\u0415\u041B\u0401\u041D\u042B\u0419"
  - key: YELLOW
    text: "\u0416\u0401\u041B\u0422\u042B\u0419"
  - key: MAGENTA
    text: "\u041F\u0423\u0420\u041F\u0423\u0420\u041D\u042B\u0419"
  - key: CHANGES ARE APPLIED IMMEDIATELY
    text: "\u0418\u0417\u041C\u0415\u041D\u0415\u041D\u0418\u042F \u041F\u0420\u0418\u041C\u0415\u041D\u042F\u042E\u0422\u0421\u042F
      \u0421\u0420\u0410\u0417\u0423"
  - key: CHANGES ARE SAVED AUTOMATICALLY
    text: "\u0418\u0417\u041C\u0415\u041D\u0415\u041D\u0418\u042F \u0421\u041E\u0425\u0420\u0410\u041D\u042F\u042E\u0422\u0421\u042F
      \u0410\u0412\u0422\u041E\u041C\u0410\u0422\u0418\u0427\u0415\u0421\u041A\u0418"
  - key: RIGHT NOW ONLY 1920x1080 resolution is supported. later it will be chabged
    text: "\u0421\u0415\u0419\u0427\u0410\u0421 \u041F\u041E\u0414\u0414\u0415\u0420\u0416\u0418\u0412\u0410\u0415\u0422\u0421\u042F
      \u0422\u041E\u041B\u042C\u041A\u041E \u0420\u0410\u0417\u0420\u0415\u0428\u0415\u041D\u0418\u0415
      1920x1080"
  - key: This is an early development build. Gameplay, levels, models, textures,
      audio, and balancing are still works in progress. Expect bugs, unfinished content,
      and significant changes in future versions. Thank you for playing!
    text: "Это ранняя версия игры. Игровой процесс, уровни, модели, текстуры, звук и баланс всё ещё находятся в разработке. Возможны ошибки, незавершённый контент и значительные изменения в будущих версиях. Спасибо за игру!"
  - key: LEVEL SELECT
    text: "\u0412\u042B\u0411\u041E\u0420 \u0423\u0420\u041E\u0412\u041D\u042F"
  - key: TRIALS
    text: "\u0418\u0421\u041F\u042B\u0422\u0410\u041D\u0418\u042F"
  - key: LEVELS
    text: "\u0423\u0420\u041E\u0412\u041D\u0418"
  - key: Trials
    text: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F"
  - key: Levels
    text: "\u0423\u0440\u043E\u0432\u043D\u0438"
  - key: COMING SOON
    text: "\u0421\u041A\u041E\u0420\u041E"
  - key: START
    text: "\u0421\u0422\u0410\u0420\u0422"
  - key: FINAL TEST
    text: "\u0424\u0418\u041D\u0410\u041B\u042C\u041D\u042B\u0419 \u0422\u0415\u0421\u0422"
  - key: LICENSE TEST
    text: "\u042D\u041A\u0417\u0410\u041C\u0415\u041D \u041D\u0410 \u041B\u0418\u0426\u0415\u041D\u0417\u0418\u042E"
  - key: MOVEMENT
    text: "\u0414\u0412\u0418\u0416\u0415\u041D\u0418\u0415"
  - key: Trial 1 Move
    text: "Испытание 1 - Движение"
  - key: Trial 2 - Shoot
    text: "Испытание 2 - Стрельба"
  - key: Trial 3 - Shotgun
    text: "Испытание 3 - Дробовик"
  - key: Trial 4 - Rifle & Slide
    text: "Испытание 4 - Винтовка и скольжение"
  - key: Trial 5 - Heavy Lift
    text: "Испытание 5 - Тяжёлый калибр"
  - key: Final Trial
    text: "Финальное испытание"
  - key: EXIT
    text: "\u0412\u042B\u0425\u041E\u0414"
  - key: PAUSED
    text: "\u041F\u0410\u0423\u0417\u0410"
  - key: Continue
    text: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C"
  - key: Retry
    text: "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u044C"
  - key: Menu
    text: "\u041C\u0435\u043D\u044E"
  - key: TRIAL COMPLETED
    text: "\u0418\u0421\u041F\u042B\u0422\u0410\u041D\u0418\u0415 \u041F\u0420\u041E\u0419\u0414\u0415\u041D\u041E"
  - key: COMPLETE
    text: "\u0417\u0410\u0412\u0415\u0420\u0428\u0415\u041D\u041E"
  - key: YOUR TIME
    text: "\u0412\u0410\u0428\u0415 \u0412\u0420\u0415\u041C\u042F"
  - key: BEST TIME
    text: "\u041B\u0423\u0427\u0428\u0415\u0415 \u0412\u0420\u0415\u041C\u042F"
  - key: NEW RECORD
    text: "\u041D\u041E\u0412\u042B\u0419 \u0420\u0415\u041A\u041E\u0420\u0414"
  - key: RANK REQUIREMENTS
    text: "\u0422\u0420\u0415\u0411\u041E\u0412\u0410\u041D\u0418\u042F \u041A \u0420\u0410\u041D\u0413\u0423"
  - key: IMPOSSIBLE
    text: "\u041D\u0415\u0412\u041E\u0417\u041C\u041E\u0416\u041D\u041E"
  - key: GOLD
    text: "\u0417\u041E\u041B\u041E\u0422\u041E"
  - key: SILVER
    text: "\u0421\u0415\u0420\u0415\u0411\u0420\u041E"
  - key: BRONZE
    text: "\u0411\u0420\u041E\u041D\u0417\u0410"
  - key: Impossible
    text: "\u041D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E"
  - key: Gold
    text: "\u0417\u043E\u043B\u043E\u0442\u043E"
  - key: Silver
    text: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E"
  - key: Bronze
    text: "\u0411\u0440\u043E\u043D\u0437\u0430"
  - key: press Enter
    text: "\u043D\u0430\u0436\u043C\u0438\u0442\u0435 Enter"
  - key: Movement
    text: "\u0414\u0432\u0438\u0436\u0435\u043D\u0438\u0435"
  - key: Targets
    text: "\u041C\u0438\u0448\u0435\u043D\u0438"
  - key: Shotgun
    text: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A"
  - key: Rifle + Slide
    text: "\u0412\u0438\u043D\u0442\u043E\u0432\u043A\u0430 + \u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435"
  - key: Bazooka
    text: "\u0411\u0430\u0437\u0443\u043A\u0430"
  - key: License Test
    text: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D \u043D\u0430 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E"
  - key: Begin Corps training with movement, jumping, and checkpoints.
    text: "\u041D\u0430\u0447\u043D\u0438\u0442\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
      \u0432 \u041A\u043E\u0440\u043F\u0443\u0441\u0435: \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435,
      \u043F\u0440\u044B\u0436\u043A\u0438 \u0438 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0435
      \u0442\u043E\u0447\u043A\u0438."
  - key: Qualify with the pistol and clear moving training targets.
    text: "\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443
      \u0441 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u043E\u043C \u0438
      \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0435\u0441\u044F
      \u043C\u0438\u0448\u0435\u043D\u0438."
  - key: Turn shotgun recoil into a movement tool.
    text: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043E\u0442\u0434\u0430\u0447\u0443
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u044F."
  - key: Combine rifle control, sliding, and courier momentum.
    text: "\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443
      \u0438\u0437 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438, \u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435
      \u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438."
  - key: Breach barriers and redirect yourself with explosive force.
    text: "\u041F\u0440\u043E\u0431\u0438\u0432\u0430\u0439\u0442\u0435 \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u044B
      \u0438 \u043C\u0435\u043D\u044F\u0439\u0442\u0435 \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E
      \u0441\u0438\u043B\u043E\u0439 \u0432\u0437\u0440\u044B\u0432\u0430."
  - key: Pass the timed exam and earn your Space Delivery Corps license.
    text: "\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043D\u0430 \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435
      \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438."
  - key: Blue Man
    text: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440"
  - key: Blue Guy
    text: "\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u043E\u0440"
  - key: Welcome, recruit. You are training to join the Space Delivery Corps.
    text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u0440\u0435\u043A\u0440\u0443\u0442. \u0412\u044B \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
      \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u0434\u043B\u044F
      \u0432\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F \u0432 \u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u043F\u0443\u0441 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438."
  - key: Couriers cross dangerous places where normal deliveries cannot go. Start
      with the basics. Use WASD to move and SPACE to jump.
    text: "\u041A\u0443\u0440\u044C\u0435\u0440\u044B \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0442\u0430\u043C, \u043A\u0443\u0434\u0430 \u043E\u0431\u044B\u0447\u043D\u0430\u044F
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u043D\u0435 \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F.
      \u041D\u0430\u0447\u043D\u0451\u043C \u0441 \u043E\u0441\u043D\u043E\u0432:
      WASD - \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435, SPACE -
      \u043F\u0440\u044B\u0436\u043E\u043A."
  - key: This course hangs in open space, but the training recovery system is active.
      If you fall, it will return you to your latest checkpoint.
    text: "\u041F\u043E\u043B\u0438\u0433\u043E\u043D \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043A\u043E\u0441\u043C\u043E\u0441\u0435,
      \u043D\u043E \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0430\u043A\u0442\u0438\u0432\u043D\u0430. \u041F\u0440\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0438
      \u0432\u044B \u0432\u0435\u0440\u043D\u0451\u0442\u0435\u0441\u044C \u043A
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439
      \u0442\u043E\u0447\u043A\u0435."
  - key: Checkpoint confirmed. Your training record has been updated.
    text: "\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430. \u0414\u0430\u043D\u043D\u044B\u0435
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0438 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u044B."
  - key: Next is sprinting. Hold SHIFT while moving to build the speed a field courier
      needs.
    text: "\u0414\u0430\u043B\u0435\u0435 - \u0431\u0435\u0433. \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
      SHIFT \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u0443\u044E
      \u043A\u0443\u0440\u044C\u0435\u0440\u0443 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
  - key: Use a sprint jump to clear the gap ahead. Trust the recovery system if you
      miss.
    text: "\u0420\u0430\u0437\u0431\u0435\u0433\u0438\u0442\u0435\u0441\u044C \u0438
      \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0438\u0442\u0435 \u0440\u0430\u0437\u0440\u044B\u0432.
      \u0415\u0441\u043B\u0438 \u0441\u043E\u0440\u0432\u0451\u0442\u0435\u0441\u044C,
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E\u043C\u043E\u0436\u0435\u0442."
  - key: Good work, recruit. One movement section remains.
    text: "\u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0440\u0435\u043A\u0440\u0443\u0442. \u041E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0441\u0435\u043A\u0446\u0438\u044F
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
  - key: Cross the three platforms ahead and reach the trial exit.
    text: "\u041F\u0435\u0440\u0435\u0441\u0435\u043A\u0438\u0442\u0435 \u0442\u0440\u0438
      \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B \u0438 \u0434\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
      \u0434\u043E \u0432\u044B\u0445\u043E\u0434\u0430."
  - key: Complete this course and report to weapons training. A licensed courier
      must be ready for hostile delivery zones.
    text: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043A\u0443\u0440\u0441
      \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435\u0441\u044C
      \u043D\u0430 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0443\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443.
      \u041B\u0438\u0446\u0435\u043D\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043A\u0443\u0440\u044C\u0435\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C
      \u0433\u043E\u0442\u043E\u0432 \u043A \u043E\u043F\u0430\u0441\u043D\u044B\u043C
      \u0437\u043E\u043D\u0430\u043C \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438."
  - key: Welcome to weapons training. Your first courier sidearm is the pistol.
    text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u043E\u0440\u0443\u0436\u0435\u0439\u043D\u0443\u044E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443.
      \u0412\u0430\u0448\u0435 \u043F\u0435\u0440\u0432\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u043A\u0443\u0440\u044C\u0435\u0440\u0430 - \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442."
  - key: Shoot all six targets to verify your aim and activate the next platform.
    text: "\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u0435 \u0432\u0441\u0435 \u0448\u0435\u0441\u0442\u044C
      \u043C\u0438\u0448\u0435\u043D\u0435\u0439, \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u044C \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0443\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443."
  - key: Static target calibration complete. Now prove you can aim under pressure.
    text: "\u041A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0430 \u043F\u043E
      \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u043C \u043C\u0438\u0448\u0435\u043D\u044F\u043C
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0441\u0442\u0440\u0435\u043B\u044F\u0439\u0442\u0435 \u043F\u043E\u0434 \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C."
  - key: Land on the platform and shoot all three moving targets before they reach
      the end. If one escapes, the training sequence resets.
    text: "\u041F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443 \u0438
      \u043F\u043E\u0440\u0430\u0437\u0438\u0442\u0435 \u0442\u0440\u0438 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0435\u0441\u044F
      \u043C\u0438\u0448\u0435\u043D\u0438. \u0415\u0441\u043B\u0438 \u043E\u0434\u043D\u0430
      \u0443\u0439\u0434\u0451\u0442, \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0437\u0430\u043D\u043E\u0432\u043E."
  - key: Pass this section and the next course will teach you how weapons can control
      your movement.
    text: "\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0441\u0435\u043A\u0446\u0438\u044E,
      \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u0443\u0440\u0441
      \u043D\u0430\u0443\u0447\u0438\u0442 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435\u043C \u043F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438
      \u043E\u0440\u0443\u0436\u0438\u044F."
  - key: In real delivery zones, your weapon is more than protection. Recoil can
      become a movement tool.
    text: "\u0412 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0437\u043E\u043D\u0430\u0445
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0441\u043B\u0443\u0436\u0438\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0430\u0449\u0438\u0442\u043E\u0439. \u041E\u0442\u0434\u0430\u0447\u0443
      \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
  - key: Every weapon applies a different amount of force. Learning that force can
      keep a courier alive.
    text: "\u041A\u0430\u0436\u0434\u043E\u0435 \u043E\u0440\u0443\u0436\u0438\u0435
      \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0440\u0430\u0437\u043D\u0443\u044E
      \u0441\u0438\u043B\u0443 \u043E\u0442\u0434\u0430\u0447\u0438. \u0417\u043D\u0430\u043D\u0438\u0435
      \u044D\u0442\u043E\u0439 \u0441\u0438\u043B\u044B \u043C\u043E\u0436\u0435\u0442
      \u0441\u043F\u0430\u0441\u0442\u0438 \u043A\u0443\u0440\u044C\u0435\u0440\u0443
      \u0436\u0438\u0437\u043D\u044C."
  - key: This course uses the shotgun. Jump and fire at the ground beneath you to
      boost upward.
    text: "\u0412 \u044D\u0442\u043E\u043C \u043A\u0443\u0440\u0441\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A. \u041F\u0440\u044B\u0433\u043D\u0438\u0442\u0435
      \u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435 \u0432
      \u0437\u0435\u043C\u043B\u044E \u043F\u043E\u0434 \u0441\u043E\u0431\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u0432\u0437\u043B\u0435\u0442\u0435\u0442\u044C
      \u0432\u044B\u0448\u0435."
  - key: Remember this before you enter a live delivery zone.
    text: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435 \u044D\u0442\u043E
      \u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C \u0432
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0437\u043E\u043D\u0443
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438."
  - key: The shotgun gives you a stronger push when you fire at a nearby surface
      than when you fire into open space.
    text: "\u0414\u0440\u043E\u0431\u043E\u0432\u0438\u043A \u0442\u043E\u043B\u043A\u0430\u0435\u0442
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u043F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435
      \u0432 \u0431\u043B\u0438\u0437\u043A\u0443\u044E \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C,
      \u0447\u0435\u043C \u043F\u0440\u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0435
      \u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E."
  - key: Use that extra force to reach the next platform.
    text: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0441\u0438\u043B\u0443, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B."
  - key: Good. Now combine weapon handling with movement.
    text: "\u0425\u043E\u0440\u043E\u0448\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u043E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0441 \u043E\u0440\u0443\u0436\u0438\u0435\u043C \u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435."
  - key: Use the pistol to clear the targets and activate the platform.
    text: "\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u0435 \u043C\u0438\u0448\u0435\u043D\u0438
      \u0438\u0437 \u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u0430 \u0438
      \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0439\u0442\u0435 \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443."
  - key: Then use the shotgun to reach the finish. Face away from it, move BACKWARD,
      and fire to push yourself toward the exit.
    text: "\u0417\u0430\u0442\u0435\u043C \u0434\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
      \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0434\u0440\u043E\u0431\u043E\u0432\u0438\u043A\u0430. \u041F\u043E\u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
      \u0441\u043F\u0438\u043D\u043E\u0439, \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      \u041D\u0410\u0417\u0410\u0414 \u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C
      \u0441\u0435\u0431\u044F \u043A \u0432\u044B\u0445\u043E\u0434\u0443."
  - key: This trial adds the rifle, the Corps standard for sustained fire. Keep moving
      while you clear groups of targets.
    text: "\u0412 \u044D\u0442\u043E\u043C \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0438
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0430
      - \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442 \u041A\u043E\u0440\u043F\u0443\u0441\u0430
      \u0434\u043B\u044F \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F. \u041D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C,
      \u043F\u043E\u0440\u0430\u0436\u0430\u044F \u0433\u0440\u0443\u043F\u043F\u044B
      \u043C\u0438\u0448\u0435\u043D\u0435\u0439."
  - key: Its recoil gives only a small movement push. Its strength is clearing several
      threats without breaking your flow.
    text: "\u0415\u0451 \u043E\u0442\u0434\u0430\u0447\u0430 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0435 \u0442\u043E\u043B\u043A\u0430\u0435\u0442. \u0413\u043B\u0430\u0432\u043D\u043E\u0435
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E -
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0438\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0443\u0433\u0440\u043E\u0437 \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u0438
      \u0442\u0435\u043C\u043F\u0430."
  - key: Clear the seven targets ahead to open the first gate.
    text: "\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u0435 \u0441\u0435\u043C\u044C
      \u043C\u0438\u0448\u0435\u043D\u0435\u0439 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430."
  - key: Fast deliveries demand control in tight spaces. Hold LEFT CTRL while moving
      downhill to begin a slide.
    text: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u0432 \u0442\u0435\u0441\u043D\u044B\u0445 \u043C\u0435\u0441\u0442\u0430\u0445.
      \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 LEFT CTRL
      \u043F\u0440\u0438 \u0441\u043F\u0443\u0441\u043A\u0435, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0430\u0447\u0430\u0442\u044C \u0441\u043A\u043E\u043B\u044C\u0436\u0435\u043D\u0438\u0435."
  - key: Stay low beneath the gate, then jump from the runway to carry your speed
      across the gap.
    text: "\u041F\u0440\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0438\u0442\u0435
      \u043F\u043E\u0434 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438, \u0437\u0430\u0442\u0435\u043C
      \u043F\u0440\u044B\u0433\u043D\u0438\u0442\u0435 \u0441 \u0440\u0430\u0437\u0433\u043E\u043D\u0430,
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043D\u0430\u0434 \u0440\u0430\u0437\u0440\u044B\u0432\u043E\u043C."
  - key: Now combine both lessons. Shoot every moving target while sliding through
      the final lane.
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u0435
      \u043E\u0431\u0430 \u043D\u0430\u0432\u044B\u043A\u0430. \u041F\u043E\u0440\u0430\u0437\u0438\u0442\u0435
      \u0432\u0441\u0435 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0435\u0441\u044F
      \u043C\u0438\u0448\u0435\u043D\u0438, \u0441\u043A\u043E\u043B\u044C\u0437\u044F
      \u043F\u043E \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0435."
  - key: The finish gate opens when the last target falls. Reach it without losing
      your courier momentum.
    text: "\u0424\u0438\u043D\u0438\u0448\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043C\u0438\u0448\u0435\u043D\u0438.
      \u0414\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C \u0434\u043E \u043D\u0438\u0445,
      \u043D\u0435 \u0442\u0435\u0440\u044F\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
  - key: Heavy cargo routes may require the bazooka. It carries one rocket, but no
      other courier weapon can match its impact.
    text: "\u041D\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0445 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445
      \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u044C\u0441\u044F
      \u0431\u0430\u0437\u0443\u043A\u0430. \u0412 \u043D\u0435\u0439 \u043E\u0434\u043D\u0430
      \u0440\u0430\u043A\u0435\u0442\u0430, \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E
      \u043E\u0440\u0443\u0436\u0438\u0435 \u043A\u0443\u0440\u044C\u0435\u0440\u0430
      \u043D\u0435 \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0441\u044F \u0441
      \u0435\u0451 \u043C\u043E\u0449\u044C\u044E."
  - key: Fire at the reinforced red wall ahead. Only a heavy impact can breach this
      training barrier.
    text: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435 \u0432 \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u0443\u044E
      \u043A\u0440\u0430\u0441\u043D\u0443\u044E \u0441\u0442\u0435\u043D\u0443.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u0449\u043D\u044B\u0439 \u0443\u0434\u0430\u0440
      \u043F\u0440\u043E\u0431\u044C\u0451\u0442 \u044D\u0442\u043E\u0442 \u0443\u0447\u0435\u0431\u043D\u044B\u0439
      \u0431\u0430\u0440\u044C\u0435\u0440."
  - key: Rockets take time to travel. Start reloading while you continue forward.
    text: "\u0420\u0430\u043A\u0435\u0442\u0435 \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0451\u0442. \u041D\u0430\u0447\u043D\u0438\u0442\u0435
      \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0443, \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044F
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435."
  - key: Now use the blast for movement. Jump, look down and slightly behind you,
      then fire at the orange training plate.
    text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0432\u0437\u0440\u044B\u0432 \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F.
      \u041F\u0440\u044B\u0433\u043D\u0438\u0442\u0435, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432\u043D\u0438\u0437 \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043D\u0430\u0437\u0430\u0434, \u0437\u0430\u0442\u0435\u043C \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435
      \u0432 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443."
  - key: The blast pushes you away from its impact point. Hold forward in the air
      and land on the platform above.
    text: "\u0412\u0437\u0440\u044B\u0432 \u043E\u0442\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442 \u0442\u043E\u0447\u043A\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F.
      \u0423\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435
      \u0438 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u044E\u044E \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0443."
  - key: A trained Corps courier can also use a bazooka to redirect in mid-air.
    text: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0443\u0440\u044C\u0435\u0440 \u041A\u043E\u0440\u043F\u0443\u0441\u0430
      \u043C\u043E\u0436\u0435\u0442 \u043C\u0435\u043D\u044F\u0442\u044C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0431\u0430\u0437\u0443\u043A\u0438."
  - key: Jump forward and fire at the orange plate on the left wall. Its blast will
      push you right toward the next platform.
    text: "\u041F\u0440\u044B\u0433\u043D\u0438\u0442\u0435 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435 \u0432
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443
      \u043D\u0430 \u043B\u0435\u0432\u043E\u0439 \u0441\u0442\u0435\u043D\u0435.
      \u0412\u0437\u0440\u044B\u0432 \u043E\u0442\u0431\u0440\u043E\u0441\u0438\u0442
      \u0432\u0430\u0441 \u0432\u043F\u0440\u0430\u0432\u043E \u043A \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435."
  - key: Final sequence. Breach the reinforced wall and reload while running.
    text: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C.
      \u041F\u0440\u043E\u0431\u0435\u0439\u0442\u0435 \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u0443\u044E
      \u0441\u0442\u0435\u043D\u0443 \u0438 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0438\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0431\u0435\u0433\u0443."
  - key: At the edge, jump and fire at the orange plate behind you. Ride the blast
      toward the finish.
    text: "\u0423 \u043A\u0440\u0430\u044F \u043F\u0440\u044B\u0433\u043D\u0438\u0442\u0435
      \u0438 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u0435 \u0432
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435
      \u0432\u0437\u0440\u044B\u0432, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u043B\u0435\u0442\u0435\u0442\u044C
      \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430."
  - key: Recruit, this is your Space Delivery Corps licensing exam. Cross the start
      line to begin the timer, then use everything you learned to reach the finish.
      Pass this test and your courier license will unlock real delivery assignments.
      Training recovery remains active here; outside this facility, it will not save
      you.
    text: "\u0420\u0435\u043A\u0440\u0443\u0442, \u044D\u0442\u043E \u044D\u043A\u0437\u0430\u043C\u0435\u043D
      \u043D\u0430 \u043B\u0438\u0446\u0435\u043D\u0437\u0438\u044E \u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438.
      \u041F\u0435\u0440\u0435\u0441\u0435\u043A\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0443\u044E
      \u043B\u0438\u043D\u0438\u044E \u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u0435
      \u0432\u0441\u0435 \u043D\u0430\u0432\u044B\u043A\u0438, \u0447\u0442\u043E\u0431\u044B
      \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E \u0444\u0438\u043D\u0438\u0448\u0430.
      \u0423\u0441\u043F\u0435\u0445 \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F. \u0417\u0434\u0435\u0441\u044C
      \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F
      \u0435\u0449\u0451 \u0430\u043A\u0442\u0438\u0432\u043D\u0430; \u0437\u0430
      \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438 \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0430
      \u043E\u043D\u0430 \u0432\u0430\u0441 \u043D\u0435 \u0441\u043F\u0430\u0441\u0451\u0442."

